# ============================================================
# NEXUS-PI Security & Git Ignore Configuration
# ============================================================

# --- Sensitive Environment & API Keys ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# --- Python Environments & Caches ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node & Frontend Dependencies ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.swp
*.swo

# --- Local SQLite Database ---
*.db
*.sqlite3
data/*.db
