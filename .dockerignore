# ============================================================
# NEXUS-PI — .dockerignore
# Keep the build context lean and prevent secrets / dev
# artifacts from leaking into image layers.
# ============================================================

# ── Version control ──
.git
.gitignore

# ── Environment & secrets (NEVER bake into images) ──
.env
.env.*
!.env.example

# ── Python caches ──
__pycache__
*.pyc
*.pyo
*.egg-info
dist/
build/
.eggs/

# ── Virtual environments ──
venv/
.venv/
env/

# ── IDE / editor configs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing & coverage ──
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Frontend (not part of the backend image) ──
frontend/

# ── Infrastructure / IaC (not needed at runtime) ──
infrastructure/
monitoring/

# ── Container & deploy configs (not needed inside the image) ──
Dockerfile
docker-compose*.yml
.dockerignore
render.yaml
Procfile

# ── Documentation ──
README.md
AGENTS.md
CLAUDE.md
docs/
*.md

# ── OS junk ──
.DS_Store
Thumbs.db

# ── Misc ──
*.log
*.bak
*.tmp
