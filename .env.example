# ============================================================
# NEXUS-PI Enterprise AI Mesh — Environment Configuration
# ============================================================
# Copy this file to .env and configure your desired AI models.
# (Note: The platform includes high-fidelity fallback for any missing keys,
# allowing seamless offline hackathon judging and live demonstrations).

# ------------------------------------------------------------
# 1. PRIMARY AI ORCHESTRATION & REASONING (OpenAI)
# ------------------------------------------------------------
# Provides: GPT-4o Multi-Agent Graph, Whisper v3 Audio Dictation, DALL-E 3 Schematics
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------
# 2. MULTIMODAL VISION & PDF PARSER (Google Gemini)
# ------------------------------------------------------------
# Provides: Gemini 2.5 Flash / 1.5 Pro Nameplate OCR & PDF Ingestion
# Get FREE key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ------------------------------------------------------------
# 3. LLM-AS-JUDGE & TAXONOMY VALIDATOR (Anthropic Claude)
# ------------------------------------------------------------
# Provides: Claude 3.7 Sonnet 4D Confidence Auditing & B2B Copywriting
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# 4. REAL-TIME LIVE WEB SEARCH (Optional)
# ------------------------------------------------------------
# Provides: Live crawling of OEM portals and distributor inventories
# Get key from: https://serpapi.com/
SERPAPI_API_KEY=

# ------------------------------------------------------------
# 5. MODEL SELECTION MATRIX
# ------------------------------------------------------------
PRIMARY_MODEL=gpt-4o
ANALYSIS_MODEL=gpt-4o
ENRICHMENT_MODEL=gpt-4o
VALIDATION_MODEL=gpt-4o

# ------------------------------------------------------------
# 6. AUTONOMOUS HITL ESCALATION THRESHOLDS
# ------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.70
MAX_SEARCH_RESULTS=5
ENABLE_WEB_SEARCH=true
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 7. FASTAPI SERVER SETTINGS
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
